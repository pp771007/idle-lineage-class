# 暫存 / 測試(一次性腳本、Playwright、截圖等)
.scratch/

# 測試用的真實存檔(玩家角色資料,絕不進版控)。
#   與 .scratch/ 的差別:.scratch 是用完即丟,這裡是「長期留著的測試素材」,session 結束不要清。
#   為什麼要有:空帳號測不出「大背包卡頓 / 倉庫塞滿 / 高等技能 / 離線結算」這類問題——
#   反覆用新角色測 = 反覆得到假綠燈(踩過很多次)。
.testdata/

# 相依套件
node_modules/

# Cloudflare Wrangler 本機快取/狀態(cf-sync-trigger 部署時產生,不進 git)
.wrangler/

# 村莊動態地圖資料(tools/gen-townmap.js 產生、約 235MB)放 Cloudflare R2,不進 repo;
#   repo 只留 hero.js 跟入口 remote.json(tools/upload-r2.mjs 寫的)
assets/townmap/towns.json
assets/townmap/hunts.json
assets/townmap/portals.json
assets/townmap/m*.json
assets/townmap/m*/
# R2 上傳金鑰(tools/upload-r2.mjs 讀),絕不進版控
.env.r2

# OS / 編輯器雜物
Thumbs.db
desktop.ini
.DS_Store
